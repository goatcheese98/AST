---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/lum.css';
interface Props { title: string; description?: string; }
const { title, description = 'Sandwich recipes from Sando Hub.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Sando Hub</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="lum-page">
    <a class="skip" href="#main-content">Skip to main content</a>
    <div class="lum-shell">
      <header class="lum-nav">
        <a class="brand" href="/">Sando Hub</a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/recipes/" aria-current={Astro.url.pathname === '/recipes/' || Astro.url.pathname === '/recipes' ? 'page' : undefined}>Recipes</a>
        </nav>
      </header>
      <main id="main-content" tabindex="-1"><slot /></main>
      <footer>© {new Date().getFullYear()} Sando Hub</footer>
    </div>
  </body>
</html>
