---
import RecipeLayout from '../../layouts/RecipeLayout.astro';
import { getAllRecipes } from '../../services/recipeService';
import { recipePath, type Recipe } from '../../services/directus';
let recipes: Recipe[] = [];
let failed = false;
try { recipes = await getAllRecipes(); } catch { failed = true; }
---
<RecipeLayout title="All Recipes">
  <header class="intro"><p class="muted">SANDO HUB</p><h1>All Recipes</h1><p class="description muted">Browse our sandwich recipes and find your next favorite meal.</p></header>
  {failed ? <section class="state"><h2>Recipes are unavailable</h2><p>We could not load the recipe collection. Please try again later.</p><a class="button" href="/recipes/">Try again</a><a href="/">Back to home</a></section> : recipes.length === 0 ?
    <section class="state"><h2>No recipes yet</h2><p>Check back soon for new recipes.</p><a class="button" href="/">Back to home</a></section> :
    <ul class="recipe-list">{recipes.map(recipe => <li><article><h2><a href={recipePath(recipe)}>{recipe.title}</a></h2><p class="muted">{recipe.short_description}</p><p class="meta">{recipe.tags.join(' · ')}</p></article></li>)}</ul>}
</RecipeLayout>
