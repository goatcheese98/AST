---
import SvelteEdgeCarousel from '../svelte/SvelteEdgeCarousel.svelte';
import { getAllRecipes } from '../../services/recipeService';
let recipes: Awaited<ReturnType<typeof getAllRecipes>> = [];
let failed = false;
try { recipes = await getAllRecipes({ query: { limit: 7 } }); } catch { failed = true; }
const items = recipes.map(r => ({ id: r.id, title: r.title, image: r.imageUrl ?? '',
  description: r.short_description ?? '', tags: r.tags, prepTime: r.prep_time ?? '',
  cookTime: r.cook_time ?? '', difficulty: r.difficulty ?? '' }));
---
<section class="featured-recipes-section">
  <h2>Must-Try Sandwiches</h2>
  {failed ? <p>Could not load featured recipes. <a href="/recipes/">Browse recipes</a></p> : items.length ?
    <SvelteEdgeCarousel items={items} carouselTitle="" client:visible /> : <p>No featured recipes available at the moment. Check back soon!</p>}
</section>
