    "astro": "^5.7.13",
    "gsap": "^3.13.0",
    "svelte": "^5.30.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "eslint": "^9.39.5",
    "sass": "^1.89.0",
    "svelte-check": "^4.3.3",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
