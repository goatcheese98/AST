{
  "name": "ast",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.ts",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "typecheck:cms": "tsc -p tsconfig.cms.json",
    "lint": "eslint src/services src/integrations tests --max-warnings=0",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build:fixture": "node tests/build-fixture.mjs",
    "check:svelte:slice": "svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings"
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.0",
    "@directus/sdk": "^19.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "7.4.1",
    "gsap": "^3.13.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "sass": "^1.89.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=9.6.5"
  }
}
